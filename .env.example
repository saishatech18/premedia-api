# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# --- Supabase (Session pooler) ---
# Dashboard → Connect → Connection string → "Session pooler".
# Use the DATABASE password (Project Settings → Database), not your Supabase login.
# URL-encode special characters in the password (e.g. @ → %40, ! → %21, # → %23).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Local Postgres in Docker (alternative) ---
# docker run -d --name premedia-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=premedia -p 5432:5432 postgres:16
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/premedia

# --- Auth ---
# Secret used to sign JWT access tokens (min 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<random-secret>
# Optional: token lifetime in minutes (default 480 = 8 hours)
# ACCESS_TOKEN_EXPIRE_MINUTES=480
